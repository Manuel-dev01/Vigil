# Copy to .env (gitignored) and fill in locally. Variable NAMES only. Never commit values.
# Testnet only (qorechain-diana). Never use an account that has ever held mainnet funds.

# Network
QORE_NETWORK=testnet
QORE_REST_URL=
QORE_RPC_URL=
QORE_EVM_RPC_URL=

# Role: creator / sequencer (keel). Read by @qorechain/rdk signerFromEnv / pqcKeypairFromEnv
QORE_MNEMONIC=
QORE_PQC_SEED_HEX=

# Role: deployer (EVM contracts; separate from drill and creator accounts)
DEPLOYER_MNEMONIC=

# Role: watchtowers (one account each)
WATCHTOWER_1_MNEMONIC=
WATCHTOWER_2_MNEMONIC=
WATCHTOWER_3_MNEMONIC=

# Role: evil submitter (fraud drills only)
EVIL_SUBMITTER_MNEMONIC=

# Role: liquidity provider (instant-exit vault)
LP_MNEMONIC=

# Target rollup
VIGIL_ROLLUP_ID=
