{
  "name": "vigil",
  "version": "0.0.0",
  "private": true,
  "description": "Vigil: a post-quantum payments rollup on QoreChain (qledger-v1, based, optimistic).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "evidence:check": "tsx scripts/evidence-check.ts",
    "redteam": "pnpm --filter @vigil/scripts redteam"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
