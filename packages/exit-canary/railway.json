{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/exit-canary/Dockerfile"
  },
  "deploy": {
    "startCommand": "node --import tsx packages/exit-canary/src/main.ts",
    "cronSchedule": "20 11 * * *",
    "restartPolicyType": "NEVER"
  }
}
